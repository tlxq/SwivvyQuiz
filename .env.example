EXPO_PUBLIC_TRIVIA_API_URL=https://opentdb.com

# Firebase Configuration
# Get these values from your Firebase Console:
# 1. Go to https://console.firebase.google.com
# 2. Create a new project or select an existing one
# 3. Create a Firestore database (Start in test mode)
# 4. Go to Project Settings → Service Accounts → Copy config
#
# Note: These values are safe to expose (set to Public in Expo) as they're restricted by Firestore rules.
# You should set Firestore rules to allow only authenticated users or specific clients.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
